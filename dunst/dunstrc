[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 200
    origin = top-right
    offset = 10x10
    scale = 0

    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    corner_radius = 6
    rounded_large = false
    gap_size = 5

    font = FiraCode Nerd Font 10

    line_height = 0

    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center

    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = false

    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = true

    enable_recursive_icon_lookup = true

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/Adwaita/16x16/status/:/usr/share/icons/Adwaita/32x32/status/:/usr/share/icons/hicolor/48x48/apps/

    sticky_history = yes
    history_length = 20

    browser = /usr/bin/google-chrome-stable
    dmenu = /usr/bin/rofi -dmenu -p dunst:

    sort = yes
    indicate_hidden = yes

    idle_threshold = 120

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#282828"
    foreground = "#ebdbb2"
    timeout = 5
    highlight = "#83a598"

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    timeout = 8
    highlight = "#83a598"

[urgency_critical]
    background = "#cc241d"
    foreground = "#ebdbb2"
    timeout = 0
    highlight = "#fb4934"
